# Copy to `.env` and fill in. docker compose reads this file both for variable
# substitution and as the container's environment.

# --- required ---------------------------------------------------------------
# OpenAI-compatible API key used for entity extraction and recall synthesis.
LLM_API_KEY=sk-your-key-here
# Bearer token clients must present on http://127.0.0.1:8080/mcp.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=change-me-to-a-long-random-string

# --- data -------------------------------------------------------------------
# Host port the MCP endpoint is published on.
MCP_HOST_PORT=8080
# Mount an existing store instead of the default empty ./data directory.
# DATA_DIR=/Users/you/.agents/reflect-mem

# --- llm (optional overrides) -----------------------------------------------
LLM_ENDPOINT=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3
# LLM_THINKING=disabled          # skip chain-of-thought (faster)

# --- embedding (optional overrides) -----------------------------------------
# Must match the model that produced reflect-mem.lancedb, or vectors are unusable.
# With the bundled Ollama profile use http://ollama:11434/api/embed instead.
EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embed
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
